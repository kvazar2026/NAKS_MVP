# Reinstalled fresh in the image from requirements.txt — never copied in.
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/

# Dev/test-only, not needed at runtime.
tests/
pyproject.toml
requirements-dev.txt

# VCS / editor noise.
.git
.gitignore
.idea
.vscode

# Uncommitted files from unrelated, in-progress work that happened to sit
# in this working tree while this Dockerfile was written. Not part of this
# app — excluded explicitly so an unrelated feature never ships inside this
# image regardless of what else is present on disk at build time.
app/api/claude_monitor.py
app/services/claude_monitor.py
